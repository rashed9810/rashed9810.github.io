---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found — ${site.name}`} noindex>
  <main id="main" class="wrap grid min-h-dvh place-content-center py-24">
    <p class="text-sm text-faint">404</p>
    <h1 class="mt-2 text-5xl font-medium text-ink">This page doesn't exist.</h1>
    <p class="mt-4 max-w-md text-lg text-muted">The link may be out of date. Everything on this site is on the home page.</p>
    <div class="mt-8"><a href="/" class="btn btn-primary">Go to the home page</a></div>
  </main>
</Base>
